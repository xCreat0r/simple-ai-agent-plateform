[Unit]
Description=Base Service (PDF Parser)
After=network.target

[Service]
Type=simple
User=nobody
Group=nogroup
WorkingDirectory=/app
ExecStart=/usr/local/bin/uvicorn app.main:app --host 0.0.0.0 --port 38080
Restart=always
RestartSec=5
Environment=PORT=38080
Environment=SERVICE_TOKEN=

[Install]
WantedBy=multi-user.target
