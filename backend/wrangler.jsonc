{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "src/index.ts",
	"name": "agent-platform-api",
	"compatibility_date": "2026-07-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Cloudflare Workers 不注入 NODE_ENV，显式声明以启用生产行为
		// （cookie 同站/secure 属性、logger 生产日志开关等）
		"NODE_ENV": "production"
	},
	"triggers": {
		"crons": [
			"0 */6 * * *"
		]
	},
	// 观测：开启 Workers Logs / 异常追踪，仪表盘 Logs 标签可查日志（免费版也可用）
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// 嵌入服务使用 EMBEDDING_PROVIDER 环境变量切换（workers-ai / dashscope / mock）。
	// 本地开发（wrangler dev）不支持 AI binding，请用 dashscope 或 mock。
	// 生产默认启用 Workers AI binding（BGE-M3 嵌入）；若切换 dashscope，
	// 移除下方 binding 并配置 DASHSCOPE_API_KEY secret。
	"ai": { "binding": "AI" },
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "14b841f1b4c74b2ab07b35d99892ea1f",
			"localConnectionString": "postgres://postgres:postgres@localhost:5432/agent_platform"
		}
	],
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "88eff2c4e20a443c9feb8ee1a4bbb4d9"
		},
		{
			"binding": "QUOTA_KV",
			"id": "63f935a10b4d47b9b92de58aad87089a"
		}
	]
}