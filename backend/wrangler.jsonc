{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "name": "agent-platform-api",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "CHANGE_ME",
      "localConnectionString": "postgres://postgres:YOUR_PASSWORD@localhost:5432/agent_platform"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "CHANGE_ME"
    },
    {
      "binding": "QUOTA_KV",
      "id": "CHANGE_ME"
    }
  ]
}
