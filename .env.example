# 数据库
# 本地开发: 在 backend/.dev.vars 中设置 DATABASE_URL
# 生产环境: 使用 Cloudflare Hyperdrive 连接 Supabase PostgreSQL

# AI 服务
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
SERPAPI_API_KEY=your-serpapi-key

# 嵌入服务（知识库 RAG）
# 取值: workers-ai（默认，生产用 Cloudflare Workers AI）/ dashscope（本地真实嵌入）/ mock（本地链路调试，无语义）
# EMBEDDING_PROVIDER=workers-ai
# DashScope（阿里云百炼）嵌入，本地调试推荐:
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# 检索参数（可选，缺省用默认值）
# KNOWLEDGE_TOP_K=3
# KNOWLEDGE_SIMILARITY_THRESHOLD=0.6
# KNOWLEDGE_CHUNK_MAX_CHARS=800
# KNOWLEDGE_CHUNK_MIN_CHARS=300
# KNOWLEDGE_CHUNK_OVERLAP=100
# KNOWLEDGE_EMBEDDING_BATCH_SIZE=8

# JWT 签名密钥（生成方式: openssl rand -base64 32）
JWT_SECRET=

# PDF 解析：Worker 内本地解析（unpdf），无需 base 服务。
# 可选：知识库参数（缺省见 src/lib/config.ts）
# KNOWLEDGE_MAX_FILE_SIZE=5242880
# KNOWLEDGE_MAX_PDF_PAGES=100

# 前端 API 地址（在 frontend/.env 中配置）
VITE_API_URL=http://localhost:8787

# CORS 白名单（逗号分隔，未配置回退默认 localhost + 预设域名）
# CORS_ORIGINS=http://localhost:5173,https://app.agent-platform.com

# 注册开关（默认关闭，未配置即禁止注册）
# 关闭时通过 seed 脚本或 SQL 创建账号；开放注册时设 true
# ALLOW_SIGNUP=true

# Cloudflare 绑定（通过 wrangler.jsonc 配置）
# Hyperdrive: HYPERDRIVE
# KV: RATE_LIMIT_KV, QUOTA_KV
# Workers AI: AI
